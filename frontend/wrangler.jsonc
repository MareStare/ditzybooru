{
  "name": "ditzybooru",
  "compatibility_date": "2026-07-19",
  "assets": {
    "directory": "./dist",

    // The frontend is a SPA: only `/` and `/assets/*` exist as real files, so
    // every other route (e.g. `/dev/styling`) must fall back to `index.html`
    // instead of 404-ing on a hard navigation.
    "not_found_handling": "single-page-application",
  },
}
