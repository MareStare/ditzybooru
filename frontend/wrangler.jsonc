{
  "name": "ditzybooru",
  "compatibility_date": "2026-07-19",

  // TanStack Start's SSR handler reaches for `node:stream`.
  "compatibility_flags": ["nodejs_compat"],

  // Start owns the server entry: it builds the request handler, the route
  // manifest and the asset links. `main` and `assets.directory` are wired to
  // its build output by the Cloudflare plugin.
  "main": "@tanstack/react-start/server-entry",
}
