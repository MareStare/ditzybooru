{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "start": "node .output/server/index.mjs",
    "deploy": "vite build && wrangler deploy",
    "type-check": "tsc --noEmit",
    "check:a11y": "vitest run --project a11y",
    "browsers:install": "playwright-core install chromium",
    "test": "vitest run",
    "e2e:live": "playwright test --config playwright.live.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.3",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-query-devtools": "^5.104.4",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "nitro": "3.0.260903-beta",
    "playwright-core": "^1.64.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  }
}
