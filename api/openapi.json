          "id": 1
        },
        "x-philomena": {
          "auth": "none",
          "routes": [
            "GET /images/:id"
          ],
          "strategies": [
            {
              "kind": "html",
              "request": {
                "method": "GET",
                "path": "/images/{id}"
              },
              "select": {
                "fields": {
                  "aspectRatio": {
                    "as": "float",
                    "attr": "data-aspect-ratio",
