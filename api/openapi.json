                  },
                  "commentCount": {
                    "as": "int",
                    "attr": "data-comment-count",
                    "sel": ".image-show-container"
                  },
                  "createdAt": {
                    "attr": "data-created-at",
                    "sel": ".image-show-container"
                  },
                  "downvotes": {
                    "as": "int",
                    "attr": "data-downvotes",
                    "sel": ".image-show-container"
                  },
                  "faves": {
                    "as": "int",
                    "attr": "data-faves",
                    "sel": ".image-show-container"
                  },
                  "height": {
                    "as": "int",
                    "attr": "data-height",
                    "sel": ".image-show-container"
                  },
                  "id": {
                    "as": "int",
                    "attr": "data-image-id",
                    "sel": ".image-show-container"
                  },
                  "representations": {
                    "attr": "data-uris",
                    "json": true,
                    "map": {
                      "full": "/full",
                      "large": "/large",
                      "medium": "/medium",
                      "small": "/small",
                      "tall": "/tall",
                      "thumb": "/thumb",
                      "thumbSmall": "/thumb_small",
                      "thumbTiny": "/thumb_tiny"
                    },
                    "sel": ".image-show-container"
                  },
                  "score": {
                    "as": "int",
                    "attr": "data-score",
                    "sel": ".image-show-container"
                  },
                  "sourceUrls": {
                    "attr": "data-source-urls",
                    "json": true,
                    "sel": ".image-show-container"
                  },
                  "tagCount": {
                    "as": "int",
                    "attr": "data-tag-count",
                    "sel": ".image-show-container"
                  },
                  "tags": {
                    "fields": {
                      "category": {
                        "attr": "data-tag-category",
                        "optional": true
                      },
                      "id": {
                        "as": "int",
                        "attr": "data-tag-id"
                      },
                      "imageCount": {
                        "as": "int",
                        "sel": ".tag__count",
                        "text": true
                      },
                      "name": {
                        "attr": "data-tag-name"
                      },
                      "slug": {
                        "attr": "data-tag-slug"
                      }
                    },
                    "many": true,
