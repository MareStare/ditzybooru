  "paths": {
    "/images/{id}": {
      "get": {
        "operationId": "getImage",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImagePage"
                }
              }
            },
            "description": "Success"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Fetch the image page: metadata, counters, media URLs and tags.",
        "tags": [
          "images"
        ],
        "x-examples": {
          "id": 1
        },
        "x-philomena": {
          "auth": "none",
          "routes": [
            "GET /images/:id"
          ],
          "strategies": [
            {
              "flavors": [
                "philomena",
                "furbooru"
              ],
              "kind": "html",
              "request": {
                "method": "GET",
                "path": "/images/{id}"
              },
              "select": {
                "fields": {
                  "aspectRatio": {
                    "as": "float",
                    "attr": "data-aspect-ratio",
                    "sel": ".image-show-container"
                  },
                  "commentCount": {
                    "as": "int",
                    "attr": "data-comment-count",
                    "sel": ".image-show-container"
                  },
                  "createdAt": {
                    "attr": "data-created-at",
                    "sel": ".image-show-container"
                  },
                  "downvotes": {
                    "as": "int",
                    "attr": "data-downvotes",
                    "sel": ".image-show-container"
                  },
                  "faves": {
                    "as": "int",
                    "attr": "data-faves",
                    "sel": ".image-show-container"
                  },
                  "height": {
                    "as": "int",
                    "attr": "data-height",
                    "sel": ".image-show-container"
                  },
                  "id": {
                    "as": "int",
                    "attr": "data-image-id",
                    "sel": ".image-show-container"
                  },
                  "representations": {
                    "attr": "data-uris",
                    "json": true,
                    "map": {
                      "full": "/full",
                      "large": "/large",
                      "medium": "/medium",
                      "small": "/small",
                      "tall": "/tall",
                      "thumb": "/thumb",
                      "thumbSmall": "/thumb_small",
                      "thumbTiny": "/thumb_tiny"
                    },
                    "sel": ".image-show-container"
                  },
                  "score": {
                    "as": "int",
                    "attr": "data-score",
                    "sel": ".image-show-container"
                  },
                  "sourceUrls": {
                    "attr": "data-source-urls",
                    "json": true,
                    "sel": ".image-show-container"
                  },
                  "tagCount": {
                    "as": "int",
                    "attr": "data-tag-count",
                    "sel": ".image-show-container"
                  },
                  "tags": {
                    "fields": {
                      "category": {
                        "attr": "data-tag-category",
                        "optional": true
                      },
                      "id": {
                        "as": "int",
                        "attr": "data-tag-id"
                      },
                      "imageCount": {
                        "as": "int",
                        "sel": ".tag__count",
                        "text": true
                      },
                      "name": {
                        "attr": "data-tag-name"
                      },
                      "slug": {
                        "attr": "data-tag-slug"
                      }
                    },
                    "many": true,
                    "sel": ".tag-list .tag[data-tag-id]"
                  },
                  "upvotes": {
                    "as": "int",
                    "attr": "data-upvotes",
                    "sel": ".image-show-container"
                  },
                  "width": {
                    "as": "int",
                    "attr": "data-width",
                    "sel": ".image-show-container"
                  }
                }
              },
              "template": "lib/philomena_web/templates/image/show.html.slime"
            },
            {
              "flavors": [
                "derpibooru"
              ],
              "kind": "json",
              "map": {
                "aspectRatio": "/image/aspect_ratio",
                "commentCount": "/image/comment_count",
                "createdAt": "/image/first_seen_at",
                "downvotes": "/image/downvotes",
                "faves": "/image/faves",
                "height": "/image/height",
                "id": "/image/id",
                "representations": {
                  "from": "/image/representations",
                  "map": {
                    "full": "/full",
                    "large": "/large",
                    "medium": "/medium",
                    "small": "/small",
                    "tall": "/tall",
                    "thumb": "/thumb",
                    "thumbSmall": "/thumb_small",
                    "thumbTiny": "/thumb_tiny"
                  }
                },
                "score": "/image/score",
                "sourceUrls": "/image/source_urls",
                "tagCount": "/image/tag_count",
                "tags": {
                  "from": "/image/tags",
                  "map": {
                    "name": ""
                  }
                },
                "upvotes": "/image/upvotes",
                "width": "/image/width"
              },
              "request": {
                "method": "GET",
                "path": "/api/v1/json/images/{id}"
              }
            }
          ]
        }
      }
    },
    "/search": {
