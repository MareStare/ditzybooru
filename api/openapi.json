                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Search images. Returns one page of results and the total match count.",
        "tags": [
          "search"
        ],
        "x-examples": {
          "perPage": 2,
          "q": "safe"
        },
        "x-philomena": {
          "auth": "none",
          "routes": [
            "GET /api/v1/json/search/images",
            "GET /search"
          ],
          "strategies": [
            {
              "kind": "json",
              "map": {
                "items": {
                  "from": "/images",
                  "map": {
                    "aspectRatio": "/aspect_ratio",
                    "commentCount": "/comment_count",
                    "createdAt": "/created_at",
                    "downvotes": "/downvotes",
                    "faves": "/faves",
                    "height": "/height",
                    "hiddenFromUsers": "/hidden_from_users",
                    "id": "/id",
                    "mimeType": "/mime_type",
                    "representations": {
                      "from": "/representations",
                      "map": {
                        "full": "/full",
                        "large": "/large",
                        "medium": "/medium",
                        "small": "/small",
                        "tall": "/tall",
                        "thumb": "/thumb",
                        "thumbSmall": "/thumb_small",
                        "thumbTiny": "/thumb_tiny"
                      }
                    },
                    "score": "/score",
                    "sourceUrls": "/source_urls",
                    "spoilered": "/spoilered",
                    "tagCount": "/tag_count",
                    "tags": "/tags",
                    "upvotes": "/upvotes",
                    "width": "/width"
                  }
                },
                "page": {
                  "as": "int",
                  "from": "$param:page"
                },
                "perPage": {
                  "as": "int",
                  "from": "$param:perPage"
                },
                "total": "/total"
              },
              "request": {
                "method": "GET",
                "path": "/api/v1/json/search/images",
                "query": {
                  "filter_id": "{filterId}",
                  "page": "{page|1}",
                  "per_page": "{perPage|15}",
                  "q": "{q|*}",
                  "sd": "{sd|desc}",
                  "sf": "{sf|created_at}"
                }
